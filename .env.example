# ── Database ─────────────────────────────────────────────
DB_HOST=db
# DB_PORT is the internal container-to-container port (Postgres listens on 5432).
DB_PORT=5432
DB_NAME=bilimbaga
DB_USER=bilimbaga
DB_PASSWORD=changeme
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_SECONDS=300
DB_SSLMODE=disable

# ── API ──────────────────────────────────────────────────
API_PORT=8080
API_BASE_URL=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Security ─────────────────────────────────────────────
BCRYPT_COST=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Host port mappings ───────────────────────────────────
# Override these to avoid conflicts with services already on your machine.
# HOST_DB_PORT is the host-side bind port. Keep DB_PORT at 5432 for in-network access.
HOST_DB_PORT=5432
HOST_API_PORT=8080
HOST_HTTP_PORT=80
HOST_MAILHOG_SMTP_PORT=1025
HOST_MAILHOG_UI_PORT=8025

# ── Email / SMTP ─────────────────────────────────────────
# For local development, Mailhog is pre-configured in docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_FROM=BilimBaga <noreply@bilimbaga.local>
TENANT_TIMEZONE=Asia/Almaty
