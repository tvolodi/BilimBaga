# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bilimbaga
DB_USER=bilimbaga
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_IDLE_SECONDS=300
DB_CONN_MAX_LIFETIME=5m

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080
# Public base URL of the frontend SPA; certificate QR codes link to {PUBLIC_APP_URL}/verify/{code}
PUBLIC_APP_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-secret-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Security
BCRYPT_COST=12
# Initial password for the seeded super_admin (admin@bilimbaga.local), applied at API startup
# only while the admin still has the default password. Must satisfy the complexity policy
# (8+ chars, upper, lower, digit) and differ from the default. Never logged. When unset, the
# admin keeps the default password but is forced to change it at first login (ISS-150) and a
# startup WARNING is logged. Set this for any publicly reachable deployment.
# BOOTSTRAP_ADMIN_PASSWORD=
# Alternative: generate a random one-time admin password and log it ONCE at startup.
# BOOTSTRAP_ADMIN_GENERATE=false
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
# SMTP_FROM: sender address, "user@host" or "Name <user@host>". If SMTP_HOST is set and this is
# empty, "BilimBaga <noreply@localhost>" is used with a startup warning; an invalid value fails startup.
SMTP_FROM=noreply@example.com
TENANT_TIMEZONE=UTC

# Logging
LOG_LEVEL=info

# Anthropic AI (FR-BB71)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Host port mappings (docker-compose only — not read by the Go binary)
# Override these to avoid conflicts with services already on your machine.
HOST_DB_PORT=5432
HOST_API_PORT=8080
# BB_API_PORT overrides the host API port (precedence over HOST_API_PORT; also the fallback for
# API_PORT when running the Go binary directly). E2E_API_URL overrides the full API URL for e2e/scripts.
# BB_API_PORT=18080
# E2E_API_URL=http://localhost:18080
HOST_HTTP_PORT=80
HOST_MAILHOG_SMTP_PORT=1025
HOST_MAILHOG_UI_PORT=8025
