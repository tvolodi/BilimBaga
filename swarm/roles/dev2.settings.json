{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(gh *)",
      "Bash(git *)",
      "SendMessage",
      "Agent",
      "Skill",
      "Edit",
      "Write",
      "Bash(go *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(make *)",
      "Bash(docker *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main --force*)",
      "Bash(git reset --hard origin*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)",
      "Bash(gh ssh-key*)",
      "Bash(gh gpg-key*)",
      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(scoop *)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(Remove-Item -Recurse -Force C:*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/backend/migrations/00[1-9]_*)",
      "Edit(**/backend/migrations/01[0-9]_*)",
      "Edit(**/backend/migrations/02[0-9]_*)",
      "Edit(**/backend/migrations/030_*)",
      "Read(**/.env)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Edit(**/.claude/settings*)",
      "Edit(**/CLAUDE.md)"
    ]
  }
}