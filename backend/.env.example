# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bilimbaga
DB_USER=bilimbaga
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_IDLE_SECONDS=300
DB_CONN_MAX_LIFETIME=5m

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080

# JWT
JWT_SECRET=change-me-to-a-secret-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Security
BCRYPT_COST=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_FROM=noreply@example.com
TENANT_TIMEZONE=UTC

# Logging
LOG_LEVEL=info
