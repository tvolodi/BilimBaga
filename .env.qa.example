# QA instance (bilimbaga-qa.ai-dala.com) env template. Copy to /opt/apps/bilimbaga-qa/.env on the
# host and fill in real secrets there. Never commit real values. Separate from the test instance.
DB_HOST=db
DB_PORT=5432
DB_NAME=bilimbaga_qa
DB_USER=bilimbaga_qa
DB_PASSWORD=replace-with-strong-random-password
DB_SSLMODE=disable

API_PORT=8080
API_BASE_URL=https://bilimbaga-qa.ai-dala.com
PUBLIC_APP_URL=https://bilimbaga-qa.ai-dala.com

JWT_SECRET=replace-with-at-least-32-random-chars-unique-to-qa
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

BCRYPT_COST=12
COOKIE_DOMAIN=bilimbaga-qa.ai-dala.com
COOKIE_SECURE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_FROM=BilimBaga QA <noreply@bilimbaga-qa.ai-dala.com>
TENANT_TIMEZONE=Asia/Almaty
