# ── Database ─────────────────────────────────────────────
DB_HOST=db
# DB_PORT is the internal container-to-container port (Postgres listens on 5432).
DB_PORT=5432
DB_NAME=bilimbaga
DB_USER=bilimbaga
DB_PASSWORD=changeme
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_SECONDS=300
DB_SSLMODE=disable

# ── API ──────────────────────────────────────────────────
API_PORT=8080
API_BASE_URL=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Security ─────────────────────────────────────────────
BCRYPT_COST=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Host port mappings ───────────────────────────────────
# Override these to avoid conflicts with services already on your machine.
# HOST_DB_PORT is the host-side bind port. Keep DB_PORT at 5432 for in-network access.
HOST_DB_PORT=5432
HOST_API_PORT=8080
# BB_API_PORT overrides the host API port (precedence over HOST_API_PORT; also the fallback for
# API_PORT when running the Go binary directly). E2E_API_URL overrides the full API URL for e2e/scripts.
# BB_API_PORT=18080
# E2E_API_URL=http://localhost:18080
# E2E_BASE_URL overrides the frontend URL used by Playwright (default http://localhost:5173 for the live
# config, http://localhost:4173 for playwright.config.ts). scripts/seed-test-env.ts REQUIRES E2E_API_URL
# and accepts only an allowlist of hosts (localhost, 127.0.0.1, ::1, *.localhost, bilimbaga-qa.ai-dala.com); any other host, including bilimbaga-test.ai-dala.com (customer demo), needs ALLOW_PROTECTED_HOST=1 (user approval only). Same check for E2E_BASE_URL in e2e setup (scripts/lib/target-guard.ts).
# E2E_BASE_URL=http://localhost:5173
# The API sets no CORS headers (browser traffic is same-origin via the Vite proxy / nginx), so there is
# no CORS_ALLOWED_ORIGINS setting. PUBLIC_APP_URL (default http://localhost:5173) is the public frontend origin.
HOST_HTTP_PORT=80
HOST_MAILHOG_SMTP_PORT=1025
HOST_MAILHOG_UI_PORT=8025

# ── Email / SMTP ─────────────────────────────────────────
# For local development, Mailhog is pre-configured in docker-compose.yml.
# NOTE: docker-compose.yml overrides SMTP_HOST (=mailhog) and SMTP_PORT (=1025) for the
# api container, so the values below do not apply to `docker compose` runs. They are used
# only when running the Go binary directly (outside compose), where Mailhog is on localhost.
# Mailhog UI: http://localhost:8025 (host port from HOST_MAILHOG_UI_PORT).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_FROM=BilimBaga <noreply@bilimbaga.local>
TENANT_TIMEZONE=Asia/Almaty
